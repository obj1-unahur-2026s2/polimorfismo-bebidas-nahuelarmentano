import example.*
describe "tests bebidas y rendimiento de tito" {

  test "sin consumir nada la velocidad es 0" {
    assert.equals(0, tito.velocidad())
  }

  test "con whisky, rendimiento decrece con la dosis (potencia)" {
    tito.consumir(10, whisky)
    assert.equals(0.9 ** 10 * 490 / 70, tito.velocidad())
  }

  test "con terere, rendimiento nunca es menor a 1" {
    tito.consumir(3, terere)
    assert.equals(1 * 490 / 70, tito.velocidad())
  }

  test "con terere, dosis alta supera el piso de 1" {
    tito.consumir(50, terere)
    assert.equals(5 * 490 / 70, tito.velocidad())
  }

  test "con cianuro, velocidad siempre es 0" {
    tito.consumir(100, cianuro)
    assert.equals(0, tito.velocidad())
  }

  test "consumir reemplaza la bebida anterior" {
    tito.consumir(100, whisky)
    tito.consumir(5, cianuro)
    assert.equals(0, tito.velocidad())
  }

}